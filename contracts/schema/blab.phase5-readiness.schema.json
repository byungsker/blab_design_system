{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blab.phase5-readiness/v1",
  "type": "object",
  "required": ["schema", "metadata", "local_preparation", "exit", "blockers", "resolved_gates", "authority"],
  "properties": {
    "schema": {"const": "blab.phase5-readiness/v1"},
    "metadata": {"type": "object", "required": ["version", "status", "package_version", "package_state", "release_target"]},
    "local_preparation": {"type": "object"},
    "exit": {"type": "object", "required": ["phase5_complete", "delivery_ready", "publication_ready", "decision", "tdc", "two_consumer_exit", "direct_flutter_consumers", "opencs"]},
    "blockers": {"type": "array", "minItems": 9},
    "resolved_gates": {"type": "array", "minItems": 2},
    "authority": {"type": "object", "required": ["git_mutation", "release", "publication", "deployment", "consumer_mutation"]}
  },
  "additionalProperties": false
}
